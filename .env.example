# Copy to .env. In production, secrets come from Secret Manager (#23): deploy/tally-secrets.sh
# fetches them at boot into tmpfs (TALLY_SECRETS_DIR, mounted at /run/secrets), and the app reads
# one file per setting from SECRETS_DIR. Production's .env then holds no secrets: leave
# POSTGRES_PASSWORD, DATABASE_URL, JWT_SIGNING_KEY, SIMPLEFIN_ENCRYPTION_KEY and RESTIC_PASSWORD
# out of it and set:
#   TALLY_SECRETS_DIR=/run/tally/secrets
#   SECRETS_DIR=/run/secrets
#   POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password
# development | test | production (production refuses placeholder secrets, disables /docs)
ENVIRONMENT=development
LOG_LEVEL=INFO
API_DOMAIN=localhost

POSTGRES_USER=tally
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tally
# inside Compose
DATABASE_URL=postgresql+psycopg://tally:change-me@db:5432/tally
# host port for compose.dev.yml (local dev and tests)
DB_HOST_PORT=5433

JWT_SIGNING_KEY=change-me
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=60

WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Tally
WEBAUTHN_ORIGIN=https://localhost

# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SIMPLEFIN_ENCRYPTION_KEY=

APNS_KEY_ID=
# Your 10-character Apple Developer Team ID. Also read by the Caddyfile for the passkey
# association file (/.well-known/apple-app-site-association). Required in production.
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.luisd07.tally
# inside the containers; Compose mounts ./secrets/apns.p8 here
APNS_PRIVATE_KEY_PATH=/run/secrets/apns.p8

# App Attest checks the App ID "<APNS_TEAM_ID>.<APNS_BUNDLE_ID>".
# true refuses sign-in and refresh without a valid assertion; flip on once the app sends them.
APP_ATTEST_REQUIRED=false
# development | production, matching the app's appattest-environment entitlement
APP_ATTEST_ENVIRONMENT=production

RECEIPTS_DIR=/data/receipts
BACKUPS_DIR=/backups
# reimbursements count toward the 1099 total (decision on #66)
REIMBURSEMENTS_ON_1099=true

# e.g. gs:<bucket>:/tally
RESTIC_REPOSITORY=
RESTIC_PASSWORD=change-me
# optional: service-account key file path. Leave unset to use
# the VM's own service account via Application Default Credentials.
GCS_KEY_FILE=

# Claude (AI assist, M9). Empty turns AI off. In production the key comes from Secret Manager
# (tally-anthropic-api-key -> anthropic_api_key), so leave it out of .env there.
ANTHROPIC_API_KEY=
# Preferred over a key: Workload Identity Federation. The VM's Google identity token
# (audience https://api.anthropic.com) is traded for a short-lived Claude token, so nothing
# needs rotating. Set the rule and organization IDs to turn it on; it wins over the key.
# These are IDs, not secrets. The workspace ID is needed only for a multi-workspace rule.
ANTHROPIC_FEDERATION_RULE_ID=
ANTHROPIC_ORGANIZATION_ID=
ANTHROPIC_SERVICE_ACCOUNT_ID=
ANTHROPIC_WORKSPACE_ID=
# AI_MODEL=claude-sonnet-5-5
# AI_MONTHLY_BUDGET_USD=90
# Per-feature model override, JSON: AI_FEATURE_MODELS={"tax_review": "claude-opus-5-5"}
