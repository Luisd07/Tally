{$API_DOMAIN} {
	header Strict-Transport-Security "max-age=31536000"
	request_body {
		max_size 15MB
	}

	# Lets the app use passkeys for this domain: "<Team ID>.<bundle ID>". The Team ID comes from
	# APNS_TEAM_ID in .env (passed in by docker-compose.yml), so none is hard-coded here.
	handle /.well-known/apple-app-site-association {
		header Content-Type application/json
		respond `{"webcredentials":{"apps":["{$APNS_TEAM_ID}.com.luisd07.tally"]}}`
	}

	reverse_proxy api:8000
}
